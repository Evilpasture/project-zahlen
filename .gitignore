# ==========================================
# ZHLN Project - Master Ignore
# ==========================================

.git/

# --- Compiled Shaders (Vulkan) ---
*.spv
*.vert.spv
*.frag.spv
*.comp.spv
*.slang-module

# --- Build Artifacts ---
build/
dist/
target/
bin/
obj/
out/
*.exe
*.dll
*.so
*.shadow
*.a
*.lib
*.pdb
*.ilk
*.exp
*.ii
compile_commands.json
.ninja_log

# --- C++ / MSVC / GCC Artifacts ---
.vs/
*.user
*.suo
*.sln.doccache
ipch/
*.pch
*.tlog
*.lastbuildstate
*.log
*.db
*.opendb
# Stray object files. Note: `zig c++ -c file -o /dev/null` silently ignores
# `-o /dev/null` and drops <basename>.o into the cwd, so ad-hoc compile probes
# run from the repo root will litter these.
*.o
*.obj
*.gcm
*.pcm

# --- Dependencies & Environment ---
.venv/
env/
node_modules/

# Fidelity test harness data (scripts/run_fidelity.py clones the Khronos
# repositories under build/fidelity/ by default — already covered by the build/
# rule). These scoped rules cover users who point the runner at an external/
# layout instead, while leaving the existing git submodules under extern/
# to their own tracking.
external/glTF-Render-Fidelity-Generator/
external/glTF-Sample-Assets/

# --- Cache & OS ---
.cache/
.pytest_cache/
__pycache__/
.DS_Store
Thumbs.db

# --- Shader Hot-Reload / Temp ---
*.tmp
*.bak

# Assets
resources/intermediate/
*.bin
*.jpg
*.ppm

# Blender source files and unpacked textures
blender/

# Others
*.patch
.Rhistory
imgui.ini

# Local performance-test baselines (machine-specific; see tests/extras/profile/PerfBaseline.hpp)
perf-baseline.json

# C++ module BMIs (GCC)
gcm.cache/

# Proprietary third parties that I obviously cannot distribute
NSightAftermath/

# --- Whitelist Vendored Third-Party Binaries & Manifests ---
!third_party/vulkan_sandbox/**

# Project tool artifacts
*_diff.md 
*_snapshot.md
repomix-output.*
