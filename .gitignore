# ==========================================
# ZHLN Project - Master Ignore
# ==========================================

# --- Downloaded vendor files ---
SMAA.hlsl

# --- Compiled Shaders (Vulkan) ---
*.spv
*.vert.spv
*.frag.spv
*.comp.spv
*.slang-module

# --- Build Artifacts ---
build/
dist/
target/
bin/
obj/
out/
*.exe
*.dll
*.so
*.shadow
*.a
*.lib
*.pdb
*.ilk
*.exp
*.ii
compile_commands.json

# --- C++ / MSVC / GCC Artifacts ---
.vs/
*.user
*.suo
*.sln.doccache
ipch/
*.pch
*.tlog
*.lastbuildstate
*.log
*.db
*.opendb
# Stray object files. Note: `zig c++ -c file -o /dev/null` silently ignores
# `-o /dev/null` and drops <basename>.o into the cwd, so ad-hoc compile probes
# run from the repo root will litter these.
*.o
*.obj
*.gcm
*.pcm

# --- Dependencies & Environment ---
.venv/
env/
node_modules/

# --- Cache & OS ---
.cache/
.pytest_cache/
__pycache__/
.DS_Store
Thumbs.db

# --- Shader Hot-Reload / Temp ---
*.tmp
*.bak

# Assets
resources/intermediate/
*.bin
*.png
*.jpg
*.ppm

# Blender source files and unpacked textures
blender/

# Others
*.patch
.Rhistory
imgui.ini

# Local performance-test baselines (machine-specific; see tests/extras/profile/PerfBaseline.hpp)
perf-baseline.json

# C++ module BMIs (GCC)
gcm.cache/

# Proprietary third parties that I obviously cannot distribute
NSightAftermath/
