# 1. Base Vulkan SDK paths
export VULKAN_SDK="$HOME/VulkanSDK/1.4.341.1/macOS"
export PATH="$VULKAN_SDK/bin:$PATH"
export VK_LAYER_PATH="$VULKAN_SDK/share/vulkan/explicit_layer.d"

# 2. Point VK_DRIVER_FILES directly to your compiled Lavapipe JSON
export VK_DRIVER_FILES="/Users/maingocboichau/mesa/install/opt/homebrew/share/vulkan/icd.d/lvp_icd.aarch64.json"

# 3. Add your custom Mesa install library path to DYLD_LIBRARY_PATH
export DYLD_LIBRARY_PATH="/Users/maingocboichau/mesa/install/opt/homebrew/lib:$VULKAN_SDK/lib:$DYLD_LIBRARY_PATH"
