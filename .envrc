# ------------------------------------------------------------------------------
# 0. Platform
# ------------------------------------------------------------------------------
IS_DARWIN=0
[ "$(uname -s)" = "Darwin" ] && IS_DARWIN=1

# ------------------------------------------------------------------------------
# 1. Vulkan SDK Auto-Detection
# ------------------------------------------------------------------------------
# Find the latest Vulkan SDK installed in $HOME or default system location
VULKAN_SDK_DIR=$(find "$HOME/VulkanSDK" -maxdepth 2 -type d -name "macOS" 2>/dev/null | sort -V | tail -n 1)

if [ -n "$VULKAN_SDK_DIR" ]; then
    export VULKAN_SDK="$VULKAN_SDK_DIR"
    export PATH="$VULKAN_SDK/bin:$PATH"
    export VK_LAYER_PATH="$VULKAN_SDK/share/vulkan/explicit_layer.d"
    # CMake: the SDK ships slang-config.cmake (libslang), so a fresh
    # configure can find libslang without a hand-pinned slang_DIR.
    # Without this, libslang only resolves from an old build cache.
    export CMAKE_PREFIX_PATH="$VULKAN_SDK${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
fi

# ------------------------------------------------------------------------------
# 2. Loader on the dyld search path
# ------------------------------------------------------------------------------
# volkInitialize() dlopens the loader *by name* -- libvulkan.dylib, then
# libvulkan.1.dylib, then libMoltenVK.dylib -- and macOS stopped searching
# /usr/local/lib in recent versions, so an SDK that is not installed
# system-wide is invisible to it. Without this the engine reports "No Vulkan
# loader available; volkInitialize() failed" even with VULKAN_SDK set.
if [ "$IS_DARWIN" = 1 ] && [ -n "$VULKAN_SDK" ] && [ -d "$VULKAN_SDK/lib" ]; then
    export DYLD_LIBRARY_PATH="$VULKAN_SDK/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
fi

# ------------------------------------------------------------------------------
# 3. Driver (ICD) Selection
# ------------------------------------------------------------------------------
# Lavapipe first, where it exists: it is the CPU driver the sandbox groups are
# built for, and the vendored copy is Linux-only
# (third_party/vulkan_sandbox/linux-x86_64), so on macOS it is present only if
# Mesa was built by hand. Fall back to MoltenVK, which is the one ICD a stock
# macOS install has (SDK or Homebrew).

# Priority 1: Check for user-compiled Mesa build in $HOME
# Priority 2: Check standard Homebrew arm64 installation
# Priority 3: Check standard Homebrew x86_64 installation
LVP_ICD_PATH=$(find \
    "$HOME/mesa/install" \
    "/opt/homebrew/share/vulkan/icd.d" \
    "/usr/local/share/vulkan/icd.d" \
    -name "lvp_icd.*.json" 2>/dev/null | head -n 1)

if [ -n "$LVP_ICD_PATH" ]; then
    export VK_DRIVER_FILES="$LVP_ICD_PATH"

    # Extract the lib directory associated with the found ICD to set DYLD_LIBRARY_PATH
    MESA_LIB_DIR=$(dirname "$LVP_ICD_PATH")/../../lib
    if [ -d "$MESA_LIB_DIR" ]; then
        export DYLD_LIBRARY_PATH="$MESA_LIB_DIR${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
    fi
elif [ "$IS_DARWIN" = 1 ]; then
    MOLTENVK_DIRS="/opt/homebrew/share/vulkan/icd.d /usr/local/share/vulkan/icd.d"
    if [ -n "$VULKAN_SDK" ]; then
        MOLTENVK_DIRS="$VULKAN_SDK/share/vulkan/icd.d $MOLTENVK_DIRS"
    fi

    MOLTENVK_ICD=$(find $MOLTENVK_DIRS -maxdepth 1 -name "MoltenVK_icd.json" 2>/dev/null | head -n 1)
    if [ -n "$MOLTENVK_ICD" ]; then
        export VK_DRIVER_FILES="$MOLTENVK_ICD"
    fi
fi

# ------------------------------------------------------------------------------
# 4. What was selected (ZHLN_ENVRC_VERBOSE=1 to see it)
# ------------------------------------------------------------------------------
# Set ZHLN_ENVRC_VERBOSE=1 in your shell before `direnv allow` / `source .envrc`
# when a run cannot find Vulkan: this is the pair of paths the loader will use.
if [ -n "$ZHLN_ENVRC_VERBOSE" ]; then
    echo "Vulkan: SDK=${VULKAN_SDK:-unset}"
    echo "Vulkan: dyld=${DYLD_LIBRARY_PATH:-unset}"
    echo "Vulkan: ICD=${VK_DRIVER_FILES:-unset}"
fi
