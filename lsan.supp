# Driver & system windowing caches
leak:libvulkan*
leak:libGLX*
leak:libnvidia*
leak:libX11*
leak:libX*
leak:libxcb*
leak:libwayland*
leak:libdbus*

# FreeType glyph & pattern caches
leak:libfreetype*
leak:libharfbuzz*

# MacOS stuff
leak:CoreAudio
leak:Network
leak:libxpc.dylib
leak:libdispatch.dylib
leak:Foundation

# Unmapped driver DSO allocations at teardown
leak:<unknown module>
leak:*unknown*
