# Driver & system windowing caches
leak:libvulkan*
leak:libGLX*
leak:libnvidia*
leak:libX11*
leak:libX*
leak:libxcb*
leak:libwayland*
leak:libdbus*

# Mesa lavapipe (llvmpipe) leaks a small pthread_once-guarded init block during
# vkCreateInstance, plus per-thread chunks reachable only from it.
# Not ours: allocation stack is libvulkan.so.1 -> <ICD> -> pthread_once -> malloc.
leak:libvulkan.so
leak:libvulkan_lvp.so
leak:lvp_icd.*
leak:libLLVM

# FreeType glyph & pattern caches
leak:libfreetype*
leak:libharfbuzz*

# MacOS stuff
leak:CoreAudio
leak:Network
leak:libxpc.dylib
leak:libdispatch.dylib
leak:Foundation

# Unmapped driver DSO allocations at teardown
leak:<unknown module>
leak:*unknown*
