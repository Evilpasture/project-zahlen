# cmake/ZTest.cmake
#
# Native `ztest` test orchestrator, zero-boilerplate C++26 namespace collection
# wrappers, and build-time manifest generation. Replaces CTest across the
# repository without CMake globbing: explicit source lists are wrapped via
# `zahlen_wrap_ztest_sources(...)` into idempotent `file(CONFIGURE)` epilogue TUs
# that reflect `namespace ZHLN::Test` (`test_*` free functions + primary-TU suite
# structs), while `${CMAKE_BINARY_DIR}/ztest_manifest.txt` records internal
# worker binaries and their owned source files for `ztest`.

include_guard(GLOBAL)

add_executable(ztest "${PROJECT_SOURCE_DIR}/tools/ztest/main.cpp")
set_target_properties(ztest PROPERTIES
    CXX_STANDARD 26
    CXX_STANDARD_REQUIRED ON
    CXX_EXTENSIONS OFF
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}"
)
target_link_libraries(ztest PRIVATE zahlen_command_line zahlen_signal)
zahlen_enable_reflection(ztest)
if(USE_SANITIZERS)
    zahlen_install_sanitizer_runtime(ztest)
endif()
if(TARGET zahlen_warnings)
    target_link_libraries(ztest PRIVATE zahlen_warnings)
endif()
if(WIN32)
    target_compile_definitions(ztest PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
endif()

set_property(GLOBAL PROPERTY ZHLN_ZTEST_MANIFEST_LINES "")

# Precompute optional hermetic Vulkan sandbox variables so `ztest --sandbox` works
# at runtime even when CMake was configured with ZHLN_TEST_VULKAN_SANDBOX=OFF.
set(_zhln_ztest_sandbox_entries "")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT ZHLN_IN_DOCKER)
    set(_zhln_sandbox_root "${PROJECT_SOURCE_DIR}/third_party/vulkan_sandbox/linux-x86_64")
    if(EXISTS "${_zhln_sandbox_root}/icd.d/lvp_icd.json")
        list(APPEND _zhln_ztest_sandbox_entries
            "VK_DRIVER_FILES=${_zhln_sandbox_root}/icd.d/lvp_icd.json"
            "VK_ICD_FILENAMES=${_zhln_sandbox_root}/icd.d/lvp_icd.json"
            "VK_LAYER_PATH=${_zhln_sandbox_root}/explicit_layer.d"
            "LD_LIBRARY_PATH=${_zhln_sandbox_root}/lib"
        )
    endif()
endif()
string(REPLACE ";" "|" _zhln_ztest_sandbox_joined "${_zhln_ztest_sandbox_entries}")

set_property(GLOBAL APPEND PROPERTY ZHLN_ZTEST_MANIFEST_LINES
    "# Auto-generated by cmake/ZTest.cmake -- consumed by build/ztest"
    "SOURCE_DIR\t${PROJECT_SOURCE_DIR}"
    "BUILD_DIR\t${CMAKE_BINARY_DIR}"
    "SANDBOX_ENV\t${_zhln_ztest_sandbox_joined}"
)

# Wraps explicit test C++ translation units with a tiny generated epilogue TU
# that includes the original source file by absolute path and instantiates
# `ZHLN::Test::AutoCollectFile<AbsPath, RelPath>`. Entry-point and helper TUs
# (`TestsMain.cpp`, `Run*Tests.cpp`, `ImageWriteImpl.cpp`) pass through
# unchanged. Uses `file(CONFIGURE)` so wrapper mtimes stay untouched across
# reconfigures and Ninja header/source `.d` dependency tracking remains exact.
function(zahlen_wrap_ztest_sources OUT_SOURCES OUT_REL_FILES)
    set(_wrapped "")
    set(_rel_files "")

    foreach(_src IN LISTS ARGN)
        get_filename_component(_fname "${_src}" NAME)
        get_filename_component(_ext "${_src}" LAST_EXT)
        if(_fname STREQUAL "TestsMain.cpp"
           OR _fname STREQUAL "ImageWriteImpl.cpp"
           OR _fname MATCHES "^Run.*Tests\\.cpp$"
           OR NOT (_ext STREQUAL ".cpp" OR _ext STREQUAL ".cxx" OR _ext STREQUAL ".cc"))
            list(APPEND _wrapped "${_src}")
            continue()
        endif()

        get_filename_component(_abs "${_src}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        file(TO_CMAKE_PATH "${_abs}" _abs_norm)
        file(RELATIVE_PATH _rel "${PROJECT_SOURCE_DIR}" "${_abs}")
        file(TO_CMAKE_PATH "${_rel}" _rel_norm)

        set(_wrap_file "${CMAKE_BINARY_DIR}/ztest_autogen/${_rel_norm}")
        get_filename_component(_wrap_dir "${_wrap_file}" DIRECTORY)
        file(MAKE_DIRECTORY "${_wrap_dir}")

        file(CONFIGURE
            OUTPUT "${_wrap_file}"
            CONTENT "// Auto-generated by cmake/ZTest.cmake -- do not edit.\n#include \"@_abs_norm@\"\n#include \"TestsAutoCollect.hpp\"\nnamespace {\nstruct ZtestUnnamedScopeAnchor {};\nconst ::ZHLN::Test::AutoCollectFile<\"@_abs_norm@\", \"@_rel_norm@\", ZtestUnnamedScopeAnchor> kZtestAutoCollect {};\n}\n"
            @ONLY
        )

        list(APPEND _wrapped "${_wrap_file}")
        list(APPEND _rel_files "${_rel_norm}")
    endforeach()

    set(${OUT_SOURCES} "${_wrapped}" PARENT_SCOPE)
    set(${OUT_REL_FILES} "${_rel_files}" PARENT_SCOPE)
endfunction()

function(zahlen_register_ztest_target TARGET_NAME)
    set(options "")
    set(oneValueArgs POOL TIMEOUT WORKING_DIRECTORY)
    set(multiValueArgs LABELS ENV FILES)
    cmake_parse_arguments(ZTEST "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(NOT TARGET "${TARGET_NAME}")
        message(FATAL_ERROR "zahlen_register_ztest_target: '${TARGET_NAME}' is not a CMake target")
    endif()

    target_link_libraries("${TARGET_NAME}" PRIVATE zahlen_command_line)

    if(NOT ZTEST_POOL)
        set(ZTEST_POOL "cpu")
    endif()
    if(NOT ZTEST_TIMEOUT)
        set(ZTEST_TIMEOUT 120)
    endif()
    if(NOT ZTEST_WORKING_DIRECTORY)
        set(ZTEST_WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
    endif()
    if(NOT ZTEST_FILES)
        get_target_property(_prop_files "${TARGET_NAME}" ZHLN_ZTEST_SOURCE_FILES)
        if(_prop_files)
            set(ZTEST_FILES "${_prop_files}")
        endif()
    endif()

    string(REPLACE ";" "," _labels_csv "${ZTEST_LABELS}")
    string(REPLACE ";" "|" _env_pipe "${ZTEST_ENV}")
    string(REPLACE ";" "|" _path_prepend_pipe "${ZHLN_RUNTIME_DLL_DIRS}")
    string(REPLACE ";" "," _files_csv "${ZTEST_FILES}")

    set(_line "TARGET\t${TARGET_NAME}\t$<TARGET_FILE:${TARGET_NAME}>\t${ZTEST_WORKING_DIRECTORY}\t${ZTEST_POOL}\t${ZTEST_TIMEOUT}\t${_labels_csv}\t${_env_pipe}\t${_path_prepend_pipe}\t${_files_csv}")
    set_property(GLOBAL APPEND PROPERTY ZHLN_ZTEST_MANIFEST_LINES "${_line}")
endfunction()

function(zahlen_finalize_ztest_manifest)
    get_property(_lines GLOBAL PROPERTY ZHLN_ZTEST_MANIFEST_LINES)
    string(REPLACE ";" "\n" _content "${_lines}")
    string(APPEND _content "\n")
    file(GENERATE
        OUTPUT "${CMAKE_BINARY_DIR}/ztest_manifest.txt"
        CONTENT "${_content}"
    )
endfunction()
