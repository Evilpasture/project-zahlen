# Generated by Zahlen Engine for consumer projects.
# Load with: cmake -S . -B build --toolchain=<prefix>/share/zahlen/ZahlenToolchain.cmake

cmake_minimum_required(VERSION 3.28)

# Select a suitable compiler unless the consumer specified CMAKE_CXX_COMPILER
# or CXX. Prefer the distro's default g++ (Arch/Fedora/Gentoo); if it is below
# the supported floor, discover version-suffixed binaries (Ubuntu/Debian).
if(NOT DEFINED CMAKE_CXX_COMPILER AND NOT DEFINED ENV{CXX})
    if(NOT "@CMAKE_CXX_COMPILER_ID@" STREQUAL "GNU")
        message(FATAL_ERROR
            "ZahlenToolchain.cmake can auto-select only GNU C++; "
            "set CMAKE_CXX_COMPILER or CXX explicitly for @CMAKE_CXX_COMPILER_ID@")
    endif()

    set(_zahlen_cxx_compiler "")
    find_program(_zahlen_default_cxx NAMES g++)
    if(_zahlen_default_cxx)
        execute_process(
            COMMAND "${_zahlen_default_cxx}" -dumpfullversion
            OUTPUT_VARIABLE _zahlen_default_version
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE _zahlen_default_result
            ERROR_QUIET)
        if("${_zahlen_default_result}" STREQUAL "0" AND
           _zahlen_default_version VERSION_GREATER_EQUAL "@ZHLN_TOOLCHAIN_MIN_GCC_VERSION@")
            set(_zahlen_cxx_compiler "${_zahlen_default_cxx}")
        endif()
    endif()

    # Search every PATH directory for g++-<version> instead of assuming Debian
    # naming or hard-coding the newest known GCC major. Pick the newest candidate
    # that meets the floor when the unversioned compiler is too old or absent.
    if(NOT _zahlen_cxx_compiler)
        file(TO_CMAKE_PATH "$ENV{PATH}" _zahlen_path_dirs)
        set(_zahlen_best_version "")
        foreach(_zahlen_path_dir IN LISTS _zahlen_path_dirs)
            if(NOT _zahlen_path_dir)
                continue()
            endif()
            file(GLOB _zahlen_versioned_candidates LIST_DIRECTORIES FALSE
                "${_zahlen_path_dir}/g++-*")
            foreach(_zahlen_candidate IN LISTS _zahlen_versioned_candidates)
                get_filename_component(_zahlen_candidate_name "${_zahlen_candidate}" NAME)
                if(NOT _zahlen_candidate_name MATCHES "^g\\+\\+-[0-9]+([.][0-9]+)*$")
                    continue()
                endif()
                execute_process(
                    COMMAND "${_zahlen_candidate}" -dumpfullversion
                    OUTPUT_VARIABLE _zahlen_candidate_version
                    OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE _zahlen_candidate_result
                    ERROR_QUIET)
                if("${_zahlen_candidate_result}" STREQUAL "0" AND
                   _zahlen_candidate_version VERSION_GREATER_EQUAL "@ZHLN_TOOLCHAIN_MIN_GCC_VERSION@" AND
                   (NOT _zahlen_best_version OR
                    _zahlen_candidate_version VERSION_GREATER _zahlen_best_version))
                    set(_zahlen_cxx_compiler "${_zahlen_candidate}")
                    set(_zahlen_best_version "${_zahlen_candidate_version}")
                endif()
            endforeach()
        endforeach()
    endif()

    if(NOT _zahlen_cxx_compiler)
        message(FATAL_ERROR
            "Zahlen requires GNU C++ >= @ZHLN_TOOLCHAIN_MIN_GCC_VERSION@ with static reflection support.\n"
            "No suitable compiler was found on PATH. Install a supported GCC or set "
            "CMAKE_CXX_COMPILER (or CXX) explicitly.")
    endif()

    set(CMAKE_CXX_COMPILER "${_zahlen_cxx_compiler}" CACHE FILEPATH "C++ compiler for Zahlen projects")
    unset(_zahlen_cxx_compiler)
    unset(_zahlen_default_cxx)
    unset(_zahlen_default_version)
    unset(_zahlen_default_result)
    unset(_zahlen_path_dirs)
    unset(_zahlen_best_version)
    unset(_zahlen_path_dir)
    unset(_zahlen_versioned_candidates)
    unset(_zahlen_candidate)
    unset(_zahlen_candidate_name)
    unset(_zahlen_candidate_version)
    unset(_zahlen_candidate_result)
endif()

set(CMAKE_CXX_STANDARD 26)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# The consumer's own sources may use the engine's reflection-based APIs.
string(APPEND CMAKE_CXX_FLAGS_INIT " @ZHLN_TOOLCHAIN_REFLECTION_FLAGS@")

# This file lives at <prefix>/share/zahlen. Resolve the prefix relatively so
# the installed store can be moved without rewriting the toolchain file.
get_filename_component(_zahlen_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
list(PREPEND CMAKE_PREFIX_PATH "${_zahlen_prefix}")

# Keep build-tree paths relocatable and let installed executables find the
# engine shared library from its active package prefix.
set(CMAKE_BUILD_RPATH_USE_ORIGIN TRUE)
list(APPEND CMAKE_INSTALL_RPATH "$ORIGIN" "${_zahlen_prefix}/@CMAKE_INSTALL_LIBDIR@")

unset(_zahlen_prefix)
