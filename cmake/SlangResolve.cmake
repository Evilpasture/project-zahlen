# One provenance decision for slangc, libslang and headers.
# Order: host -> slangpy -> Linux release -> pinned source.
option(ZHLN_SLANG_VENDORED "Force the pinned Slang source build" OFF)
option(ZHLN_SLANG_ALLOW_KNOWN_BAD "Allow Slang families affected by #9500" OFF)

# Do not import a package target until its complete candidate has passed checks:
# imported targets cannot be removed when a rejected candidate falls through.
function(_zahlen_try_slang root provenance)
    if(ZHLN_SLANG_TARGET OR NOT IS_DIRECTORY "${root}")
        return()
    endif()
    set(_exe "")
    set(_inc "")
    set(_lib "")
    foreach(_p IN ITEMS "${root}/bin/slangc${CMAKE_EXECUTABLE_SUFFIX}" "${root}/slangc${CMAKE_EXECUTABLE_SUFFIX}")
        if(EXISTS "${_p}")
            set(_exe "${_p}")
            break()
        endif()
    endforeach()
    foreach(_p IN ITEMS "${root}/include" "${root}/include/slang" "${root}")
        if(EXISTS "${_p}/slang.h" AND EXISTS "${_p}/slang-com-helper.h" AND EXISTS "${_p}/slang-com-ptr.h")
            set(_inc "${_p}")
            break()
        endif()
    endforeach()
    if(APPLE)
        file(GLOB _libs "${root}/lib/libslang-compiler*.dylib" "${root}/libslang-compiler*.dylib")
    elseif(WIN32)
        file(GLOB _libs "${root}/lib/slang*.lib" "${root}/slang*.lib")
    else()
        file(GLOB _libs "${root}/lib/libslang-compiler.so*" "${root}/lib/libslang.so*" "${root}/libslang-compiler.so*")
    endif()
    list(SORT _libs)
    if(_libs)
        list(GET _libs 0 _lib)
    endif()
    if(NOT _exe OR NOT _inc OR NOT _lib)
        message(STATUS "Slang: reject ${provenance} ${root}: incomplete compiler/library/public headers")
        return()
    endif()
    # Native builds only: do not execute a cross-platform candidate.
    if(CMAKE_CROSSCOMPILING)
        message(STATUS "Slang: reject ${provenance}: cross builds require the source fallback")
        return()
    endif()
    if(UNIX)
        find_program(_file NAMES file)
        if(_file)
            execute_process(COMMAND "${_file}" -Lb "${_lib}" OUTPUT_VARIABLE _format RESULT_VARIABLE _rc)
            if((APPLE AND NOT _format MATCHES "Mach-O") OR
               (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT _format MATCHES "ELF") OR
               (CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$" AND NOT _format MATCHES "arm64|aarch64|ARM aarch64") OR
               (CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$" AND NOT _format MATCHES "x86[_-]64|x86-64"))
                message(STATUS "Slang: reject ${provenance} ${root}: platform/architecture mismatch (${_format})")
                return()
            endif()
        endif()
    endif()
    execute_process(COMMAND "${_exe}" -version RESULT_VARIABLE _rc
        OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 15)
    if(NOT _rc EQUAL 0 OR NOT "${_out} ${_err}" MATCHES "([0-9][0-9][0-9][0-9]\\.[0-9]+)")
        message(STATUS "Slang: reject ${provenance} ${root}: compiler version not probeable")
        return()
    endif()
    set(_version "${CMAKE_MATCH_1}")
    if(NOT ZHLN_SLANG_ALLOW_KNOWN_BAD AND _version MATCHES "^(2025\\.24|2026\\.1)$")
        message(STATUS "Slang: reject ${provenance} ${root}: known-bad ${_version} (#9500)")
        return()
    endif()
    if(_lib MATCHES "([0-9][0-9][0-9][0-9]\\.[0-9]+)")
        if(NOT CMAKE_MATCH_1 STREQUAL _version)
            message(STATUS "Slang: reject ${provenance} ${root}: compiler/library version mismatch")
            return()
        endif()
    endif()
    file(GLOB _companions "${root}/lib/*slang-glslang*" "${root}/*slang-glslang*" "${root}/bin/*slang-glslang*")
    if(NOT _companions)
        message(STATUS "Slang: reject ${provenance} ${root}: missing slang-glslang companion")
        return()
    endif()
    add_library(zahlen_slang_selected UNKNOWN IMPORTED GLOBAL)
    set_target_properties(zahlen_slang_selected PROPERTIES IMPORTED_LOCATION "${_lib}" INTERFACE_INCLUDE_DIRECTORIES "${_inc}")
    set(ZHLN_SLANG_TARGET zahlen_slang_selected PARENT_SCOPE)
    set(SLANG_EXECUTABLE "${_exe}" PARENT_SCOPE)
    set(SLANG_COMPILER_DEPENDS "${_exe}" PARENT_SCOPE)
    message(STATUS "Slang: selected ${provenance} ${root} (${_version})")
endfunction()

set(SLANG_COMPILER_DEPENDS "")
set(ZHLN_SLANG_TARGET "")
if(NOT ZHLN_SLANG_VENDORED)
    # Search host paths anew. No cached SLANG_EXECUTABLE/slang_DIR or release
    # directory can override provenance on a later configure.
    set(_roots "$ENV{VULKAN_SDK}" "$ENV{SLANG_ROOT}")
    cmake_path(CONVERT "$ENV{PATH}" TO_CMAKE_PATH_LIST _host_bins)
    foreach(_bin IN LISTS _host_bins)
        if(_bin MATCHES "/_deps/slang-release/|/extern/slang/|/p2996-bin")
            continue()
        endif()
        if(EXISTS "${_bin}/slangc${CMAKE_EXECUTABLE_SUFFIX}")
            get_filename_component(_root "${_bin}" DIRECTORY)
            list(APPEND _roots "${_root}")
        endif()
    endforeach()
    list(APPEND _roots ${CMAKE_PREFIX_PATH} /opt/slang /usr/local /usr)
    list(REMOVE_DUPLICATES _roots)
    foreach(_root IN LISTS _roots)
        if(NOT _root MATCHES "/_deps/slang-release/|/extern/slang/")
            _zahlen_try_slang("${_root}" host)
        endif()
    endforeach()
    if(NOT ZHLN_SLANG_TARGET AND Python3_EXECUTABLE)
        # Local package inspection only. No pip, download or Python network I/O.
        execute_process(COMMAND "${Python3_EXECUTABLE}" -c
            "import importlib.util; s=importlib.util.find_spec('slangpy'); print(next(iter(s.submodule_search_locations), '') if s and s.submodule_search_locations else '')"
            OUTPUT_VARIABLE _wheel OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 15)
        if(_wheel)
            _zahlen_try_slang("${_wheel}" slangpy)
        endif()
    endif()
    if(NOT ZHLN_SLANG_TARGET AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
        # The downloader is only reached after both local candidates fail.
        include(SlangPrebuilt)
        if(ZHLN_SLANG_PREBUILT_DIR)
            _zahlen_try_slang("${ZHLN_SLANG_PREBUILT_DIR}" linux-release)
        endif()
    endif()
endif()
if(NOT ZHLN_SLANG_TARGET)
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/extern/slang/CMakeLists.txt")
        message(FATAL_ERROR "No compatible Slang found; initialize extern/slang with git submodule update --init --recursive")
    endif()
    if(NOT ZHLN_HAS_PYTHON)
        message(FATAL_ERROR "Vendored Slang code generation requires Python 3")
    endif()
    message(STATUS "Slang: selected vendored source ${CMAKE_CURRENT_SOURCE_DIR}/extern/slang")
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/extern/slang" EXCLUDE_FROM_ALL)
    if(TARGET slang::slang)
        set(ZHLN_SLANG_TARGET slang::slang)
    elseif(TARGET slang)
        set(ZHLN_SLANG_TARGET slang)
    else()
        message(FATAL_ERROR "Vendored Slang provides no library target")
    endif()
    set(SLANG_EXECUTABLE "$<TARGET_FILE:slangc>")
    set(SLANG_COMPILER_DEPENDS slangc)
endif()
