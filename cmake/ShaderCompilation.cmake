# One provenance decision: libslang's headers + shared library. No compiler
# executable, no compiler/library version cross-check, no ELF check on a binary
# that is no longer part of the build.
include(SlangResolve)

# SlangResolve.cmake sets ZHLN_SLANG_TARGET (the shared library) and
# ZHLN_SLANG_INCLUDE_DIR (the directory with slang.h and its C++ helpers).
# Nothing else is resolved: no compiler binary, no version gate, no ELF probe.
#
# On ELF and Mach-O the build tree's RUNPATH is how zshader loads the library it
# links (utils/zshader/CMakeLists.txt), so the commands below run bare. PE has
# no RUNPATH: exactly there, cmake -E env --modify prepends the DLL directories
# to PATH using the platform's own path-list separator. --modify leaves the
# argument list empty everywhere else, so no empty COMMAND word is ever emitted.
set(ZHLN_ZSHADER_ENV_PREFIX "")
if(WIN32)
    set(ZHLN_ZSHADER_ENV_PREFIX ${CMAKE_COMMAND} -E env
        --modify "PATH=path_list_prepend:$<TARGET_FILE_DIR:${ZHLN_SLANG_TARGET}>")
    if(TARGET slang-glslang)
        list(APPEND ZHLN_ZSHADER_ENV_PREFIX
            --modify "PATH=path_list_prepend:$<TARGET_FILE_DIR:slang-glslang>")
    endif()
endif()

# ----------------------------------------------------------------------------
# The declarative table -> manifest records. These functions do NOT run a
# compiler: they only describe a cook. Keeping the add_shader_target /
# compile_shaders shape means scripts/compile_shaders_check.py still parses the
# same table, and the shader list stays one readable CMake construct.
# ----------------------------------------------------------------------------
function(zhln_stage_of PROFILE OUT_VAR)
    set(_stage "${PROFILE}")
    if(PROFILE MATCHES "^vs_")
        set(_stage "vertex")
    elseif(PROFILE MATCHES "^ps_")
        set(_stage "fragment")
    elseif(PROFILE MATCHES "^cs_")
        set(_stage "compute")
    elseif(PROFILE MATCHES "^as_")
        set(_stage "amplification")
    elseif(PROFILE MATCHES "^ms_")
        set(_stage "mesh")
    endif()
    set(${OUT_VAR} "${_stage}" PARENT_SCOPE)
endfunction()

# One cook: emit `shader|MACRO|file|entry|stage|spv` plus one `define|` line
# per -D, and report the .spv path/source/macro for the caller's DEPENDS and
# validation lists.
function(zhln_shader_record MACRO SHADER_PATH ENTRY PROFILE)
    set(_defines ${ARGN})
    zhln_stage_of("${PROFILE}" _stage)
    get_filename_component(_file_name "${SHADER_PATH}" NAME_WE)
    set(_spv "${GEN_INCLUDE_DIR}/${_file_name}.${ENTRY}.${MACRO}.spv")
    set(_lines "shader|${MACRO}|${SHADER_PATH}|${ENTRY}|${_stage}|${_spv}")
    foreach(_define IN LISTS _defines)
        if(_define MATCHES "^-D([^=]+)=(.*)$")
            set(_name "${CMAKE_MATCH_1}")
            set(_value "${CMAKE_MATCH_2}")
            if(_value STREQUAL "")
                set(_value "1")
            endif()
        elseif(_define MATCHES "^-D([^=]+)$")
            set(_name "${CMAKE_MATCH_1}")
            set(_value "1")
        else()
            message(FATAL_ERROR "zshader: ${MACRO} passes '${_define}', which is not a -D define")
        endif()
        list(APPEND _lines "define|${MACRO}|${_name}|${_value}")
    endforeach()
    set(ZHLN_RECORD_LINES "${_lines}" PARENT_SCOPE)
    set(ZHLN_RECORD_SPV "${_spv}" PARENT_SCOPE)
    set(ZHLN_RECORD_SOURCE "${SHADER_PATH}" PARENT_SCOPE)
    set(ZHLN_RECORD_MACRO_PATH "${MACRO}=${_spv}" PARENT_SCOPE)
endfunction()

function(add_shader_target TARGET_SUFFIX)
    cmake_parse_arguments(ARG "" "" "STAGES;EXTRA_ARGS" ${ARGN})
    set(_lines "")
    set(_spvs "")
    set(_sources "")
    set(_macro_paths "")
    foreach(STAGE_DEF IN LISTS ARG_STAGES)
        string(REPLACE "|" ";" PARTS "${STAGE_DEF}")
        list(GET PARTS 0 SHADER_PATH)
        list(GET PARTS 1 ENTRY)
        list(GET PARTS 2 PROFILE)
        list(GET PARTS 3 MACRO)
        list(LENGTH PARTS PARTS_LEN)
        set(STAGE_SPECIFIC_ARGS "")
        if(PARTS_LEN GREATER 4)
            list(GET PARTS 4 STAGE_SPECIFIC_ARGS)
            string(REPLACE " " ";" STAGE_SPECIFIC_ARGS "${STAGE_SPECIFIC_ARGS}")
        endif()
        zhln_shader_record("${MACRO}" "${SHADER_PATH}" "${ENTRY}" "${PROFILE}"
                           ${ARG_EXTRA_ARGS} ${STAGE_SPECIFIC_ARGS})
        list(APPEND _lines ${ZHLN_RECORD_LINES})
        list(APPEND _spvs "${ZHLN_RECORD_SPV}")
        list(APPEND _sources "${ZHLN_RECORD_SOURCE}")
        list(APPEND _macro_paths "${ZHLN_RECORD_MACRO_PATH}")
    endforeach()
    set(ZHLN_SHADER_MANIFEST_LINES ${ZHLN_SHADER_MANIFEST_LINES} ${_lines} PARENT_SCOPE)
    set(ALL_GENERATED_SPVS ${ALL_GENERATED_SPVS} ${_spvs} PARENT_SCOPE)
    set(ALL_SHADER_ENTRY_SOURCES ${ALL_SHADER_ENTRY_SOURCES} ${_sources} PARENT_SCOPE)
    set(ALL_SHADER_MACRO_PATHS ${ALL_SHADER_MACRO_PATHS} ${_macro_paths} PARENT_SCOPE)
endfunction()

function(compile_shaders TARGET_NAME)
    set(SHADER_FILES ${ARGN})
    set(_lines "")
    set(_spvs "")
    set(_sources "")
    set(_macro_paths "")
    set(STAGE_EXTS     "VS"     "PS")
    set(STAGE_ENTRIES  "VSMain" "PSMain")
    set(STAGE_PROFILES "vs_6_5" "ps_6_5")
    foreach(SHADER_SRC IN LISTS SHADER_FILES)
        get_filename_component(FILE_NAME "${SHADER_SRC}" NAME_WLE)
        foreach(i RANGE 1)
            list(GET STAGE_EXTS     ${i} EXT)
            list(GET STAGE_ENTRIES  ${i} ENTRY)
            list(GET STAGE_PROFILES ${i} PROFILE)
            string(MAKE_C_IDENTIFIER "SHADER_${FILE_NAME}_SLANG_${EXT}_PATH" MACRO_NAME)
            string(TOUPPER "${MACRO_NAME}" MACRO_NAME)
            zhln_shader_record("${MACRO_NAME}" "${SHADER_SRC}" "${ENTRY}" "${PROFILE}")
            list(APPEND _lines ${ZHLN_RECORD_LINES})
            list(APPEND _spvs "${ZHLN_RECORD_SPV}")
            list(APPEND _sources "${ZHLN_RECORD_SOURCE}")
            list(APPEND _macro_paths "${ZHLN_RECORD_MACRO_PATH}")
        endforeach()
    endforeach()
    set(ZHLN_SHADER_MANIFEST_LINES ${ZHLN_SHADER_MANIFEST_LINES} ${_lines} PARENT_SCOPE)
    set(ALL_GENERATED_SPVS ${ALL_GENERATED_SPVS} ${_spvs} PARENT_SCOPE)
    set(ALL_SHADER_ENTRY_SOURCES ${ALL_SHADER_ENTRY_SOURCES} ${_sources} PARENT_SCOPE)
    set(ALL_SHADER_MACRO_PATHS ${ALL_SHADER_MACRO_PATHS} ${_macro_paths} PARENT_SCOPE)
endfunction()

