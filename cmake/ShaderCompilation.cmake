# transpiler's include_directories() out of the rest of the build.
add_subdirectory("${CMAKE_SOURCE_DIR}/utils/zshader" "${CMAKE_BINARY_DIR}/utils/zshader")

# The blue-noise tile is decoded here, at build time, rather than by the
# renderer at startup. It cannot come through the VFS: RenderContext::Create
# uploads it, and the Kernel builds its AssetManager and mounts data/base.pak
# only after that returns (src/engine/Kernel.cpp). What the renderer used to do
# was #embed the PNG and call stbi_load_from_memory on it every startup, which
# made it an image decoder; the cook below makes it a memcpy instead. For this
# tile that is cheaper at both ends -- 1024x1024 of noise compresses to within
# 8KB of its own raw size, and the decode disappears.
#
# Decoded by zshader (--cook-rgba / --out-rgba, utils/zshader/ImageCook.cpp) so
# the shader catalog build has zero host Python requirement.
set(ZHLN_BLUE_NOISE_SOURCE "${CMAKE_SOURCE_DIR}/src/render/LDR_RGBA_0.png")
set(ZHLN_BLUE_NOISE_COOKED "${GEN_INCLUDE_DIR}/blue_noise.rgba")
add_custom_command(
    OUTPUT "${ZHLN_BLUE_NOISE_COOKED}"
    # Same order-only rule as the catalog and gpu-types commands: $<TARGET_FILE:zshader>
    # orders zshader's link before this command without making the binary a file-level
    # DEPENDS input that would re-decode the PNG whenever zshader relinks.
    COMMAND ${ZHLN_ZSHADER_ENV_PREFIX}
        $<TARGET_FILE:zshader>
        --cook-rgba "${ZHLN_BLUE_NOISE_SOURCE}"
        --out-rgba "${ZHLN_BLUE_NOISE_COOKED}"
    DEPENDS
        "${ZHLN_BLUE_NOISE_SOURCE}"
        "${CMAKE_SOURCE_DIR}/utils/zshader/ImageCook.cpp"
    COMMENT "zshader: decoding the blue-noise tile to raw RGBA"
    VERBATIM
)


# Data blobs the renderer ships inside the binary, still #embed-ed by the
# generated byte TU (a 4 MiB literal array would be a compile-time regression).
set(ZHLN_SHADER_BLOBS
    "ltc_mat=${CMAKE_SOURCE_DIR}/src/render/ltc_mat.dds"
    "ltc_amp=${CMAKE_SOURCE_DIR}/src/render/ltc_amp.dds"
    "blue_noise_rgba=${ZHLN_BLUE_NOISE_COOKED}"
)

# --- THE MANIFEST -----------------------------------------------------------
list(APPEND ZHLN_SHADER_MANIFEST_LINES
    "header|${ZHLN_SHADER_CATALOG_HEADER}"
    "source|${ZHLN_SHADER_CATALOG_SOURCE}"
    "search|${SHADER_SRC_DIR}"
    "search|${SHADER_INCLUDE_DIR}"
    "gpu-module|gpu_abi"
    "gpu-header|${ZHLN_GPU_TYPES_HEADER}"
    "gpu-spv|${SHADER_GPU_ABI_CS_PATH}"
)
foreach(MODULE IN LISTS ZHLN_SHADER_CATALOG_MODULES)
    string(REPLACE "=" "|" RECORD "${MODULE}")
    list(APPEND ZHLN_SHADER_MANIFEST_LINES "module|${RECORD}")
endforeach()
foreach(SET IN LISTS ZHLN_SHADER_CATALOG_SETS)
    string(REPLACE "=" "|" RECORD "${SET}")
    list(APPEND ZHLN_SHADER_MANIFEST_LINES "set|${RECORD}")
endforeach()
foreach(BLOB IN LISTS ZHLN_SHADER_BLOBS)
    string(REPLACE "=" "|" RECORD "${BLOB}")
    list(APPEND ZHLN_SHADER_MANIFEST_LINES "blob|${RECORD}")
endforeach()
string(JOIN "\n" ZHLN_MANIFEST_CONTENT ${ZHLN_SHADER_MANIFEST_LINES})
set(ZHLN_MANIFEST_CONTENT "${ZHLN_MANIFEST_CONTENT}\n")
# Write only when the content changes: an identical manifest must not re-run
# the batch (and must not retrigger CMake) on every configure.
set(_zhln_current_manifest "")
if(EXISTS "${ZHLN_SHADER_MANIFEST}")
    file(READ "${ZHLN_SHADER_MANIFEST}" _zhln_current_manifest)
endif()
if(NOT _zhln_current_manifest STREQUAL ZHLN_MANIFEST_CONTENT)
    file(WRITE "${ZHLN_SHADER_MANIFEST}" "${ZHLN_MANIFEST_CONTENT}")
endif()



# ----------------------------------------------------------------------------
# THE ONE SHADER STEP
# ----------------------------------------------------------------------------
# Every output below comes from a single zshader invocation. libslang is loaded
# once; every shader is compiled once; the .spv files are written for hot
# reload while the bytes in the binary come from the generated C++ arrays.
# ----------------------------------------------------------------------------
set(ZHLN_ZSHADER_SOURCES_FOR_DEPENDS
    "${CMAKE_SOURCE_DIR}/utils/zshader/main.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/ZShader.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/ZShader.hpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/Manifest.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/Reflect.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/SlangReflect.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/SlangReflect.hpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/Emit.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/Compile.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/GpuTypes.cpp"
    "${CMAKE_SOURCE_DIR}/utils/zshader/ImageCook.cpp"
)
add_custom_command(
    OUTPUT
        "${ZHLN_SHADER_CATALOG_HEADER}"
        "${ZHLN_SHADER_CATALOG_SOURCE}"
        "${ZHLN_GPU_TYPES_HEADER}"
        "${SHADER_GPU_ABI_CS_PATH}"
        ${ALL_GENERATED_SPVS}
    # $<TARGET_FILE:zshader> orders the link before this command without making
    # the binary a file-level DEPENDS (a relink must not re-cook every shader).
    COMMAND ${ZHLN_ZSHADER_ENV_PREFIX}
        $<TARGET_FILE:zshader> --manifest "${ZHLN_SHADER_MANIFEST}"
    DEPENDS
        "${ZHLN_SHADER_MANIFEST}"
        ${ALL_SHADER_ENTRY_SOURCES}
        ${ZHLN_SHADER_COMMON_SOURCES}
        ${ZHLN_GPU_ABI_SOURCES}
        "${CMAKE_SOURCE_DIR}/src/render/ltc_mat.dds"
        "${CMAKE_SOURCE_DIR}/src/render/ltc_amp.dds"
        "${ZHLN_BLUE_NOISE_COOKED}"
        ${ZHLN_ZSHADER_SOURCES_FOR_DEPENDS}
    COMMENT "zshader: compiling Slang shaders, reflecting bindings, emitting the catalog"
    VERBATIM
)
add_custom_target(zahlen_shader_catalog
    DEPENDS "${ZHLN_SHADER_CATALOG_HEADER}" "${ZHLN_SHADER_CATALOG_SOURCE}"
)
add_custom_target(zahlen_gpu_types
    DEPENDS "${ZHLN_GPU_TYPES_HEADER}" "${SHADER_GPU_ABI_CS_PATH}"
)
add_custom_target(zahlen_shaders_spv
    DEPENDS ${ALL_GENERATED_SPVS}
)

# The consumer claims the generated files: a custom command's outputs are only
# known in the directory that declared them, so src/render/CMakeLists.txt marks
# them GENERATED and depends on the targets above. ALL_GENERATED_SPVS is
# exported to the parent scope by the functions above.
