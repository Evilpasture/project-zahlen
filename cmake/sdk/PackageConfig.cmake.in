@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(CMAKE_CONFIGURATION_TYPES OR (CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL "Release"))
    message(FATAL_ERROR "This Zahlen SDK has a Release Jolt ABI; use a single-config Release consumer")
endif()
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
# Do not silently accept a different compiler, CPU ABI, or instrumentation.
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@" OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@" OR
   NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "@CMAKE_SYSTEM_PROCESSOR@")
    message(FATAL_ERROR "Zahlen SDK requires @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@ on @CMAKE_SYSTEM_PROCESSOR@")
endif()
set(Zahlen_SANITIZER_PROFILE "release" CACHE STRING "Zahlen SDK profile: release or asan-ubsan")
if(NOT Zahlen_SANITIZER_PROFILE STREQUAL "@ZHLN_SDK_PROFILE@")
    message(FATAL_ERROR "Zahlen profile mismatch: request @ZHLN_SDK_PROFILE@ explicitly")
endif()
get_property(_zahlen_abi GLOBAL PROPERTY Zahlen_SDK_ABI)
if(_zahlen_abi AND NOT _zahlen_abi STREQUAL "@ZHLN_SDK_ABI@")
    message(FATAL_ERROR "Cannot mix Zahlen packages from different SDK builds")
endif()
set_property(GLOBAL PROPERTY Zahlen_SDK_ABI "@ZHLN_SDK_ABI@")
if(NOT _zahlen_abi)
    include(CheckCXXSourceCompiles)
    unset(_zahlen_stl_ok CACHE)
    check_cxx_source_compiles("#include <string>
#if !defined(__GLIBCXX__) || __GLIBCXX__ != @ZHLN_SDK___GLIBCXX__@ || _GLIBCXX_USE_CXX11_ABI != @ZHLN_SDK__GLIBCXX_USE_CXX11_ABI@ || defined(_GLIBCXX_DEBUG)
#error incompatible Zahlen standard library ABI
#endif
int main() { return 0; }" _zahlen_stl_ok)
    if(NOT _zahlen_stl_ok)
        message(FATAL_ERROR "Zahlen SDK requires its build's libstdc++ ABI and version")
    endif()
endif()
@ZHLN_SDK_DEPENDENCIES@
include("${CMAKE_CURRENT_LIST_DIR}/Zahlen@ZHLN_SDK_PACKAGE@Targets.cmake")
check_required_components(Zahlen@ZHLN_SDK_PACKAGE@)
