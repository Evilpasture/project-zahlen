CompileFlags:
  CompilationDatabase: "build"
  Add:
    [
      -Iinclude,
      -freflection,
      -fannotation-attributes,
      -D__cpp_impl_reflection=202603L,
      -D__glibcxx_want_reflection,
    ]

Diagnostics:
  ClangTidy:
    Add: []

---
If:
  PathMatch: .*\.(hpp|inl)
CompileFlags:
  Add:
    [
      -xc++-header,
      -std=c++26,
      -freflection,
      -D__cpp_impl_reflection=202603L,
      -D__glibcxx_want_reflection,
    ]
  Remove: [-std=*]
