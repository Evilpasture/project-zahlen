CompileFlags:
  Add:
    # 1. Look in <repo-root>/include (steps out of build/<target>/)
    - "-I../../include"
    # 2. Look in <working-dir>/include (for when clangd runs from root)
    - "-Iinclude"
    # Reflection flags for P2996 build
    - "-freflection"
    - "-fannotation-attributes"
    - "-D__cpp_impl_reflection=202603L"
    - "-D__glibcxx_want_reflection"
    - "-DJPH_DOUBLE_PRECISION"

Diagnostics:
  ClangTidy:
    Add: []
  # Silences driver warnings on standard clangd builds if reflection flags are unknown
  Suppress:
    - "drv_unknown_argument"
    - "unknown_argument"

---
If:
  PathMatch: .*\.(hpp|inl|h)
CompileFlags:
  Add:
    - "-xc++-header"
    - "-std=c++26"
  Remove:
    - "-std=*"
