# Ignore Git & Cloudflare wrangler state
.git/
.wrangler/

# Build directories & binaries
build/
dist/
target/
bin/
import/
obj/
out/
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp

# C++ build artifacts & caches
.vs/
ipch/
*.pch
*.tlog
*.o
*.obj
.cache/
.pytest_cache/
__pycache__/
gcm.cache/

# Environments & heavy local assets
.venv/
env/
node_modules/
blender/
NSightAftermath/
resources/intermediate/

# IDE configs (keep .clang-format and .clang-tidy out of here so CI can use them)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS junk & temporary files
**/.DS_Store
Thumbs.db
*.tmp
*.bak
