# Ignore Git & Cloudflare wrangler state. `**/.git` also covers the *files* a
# submodule leaves behind (extern/slang/.git is a gitfile pointing at
# ../.git/modules/...), which otherwise lands in the image and makes slang's
# GitVersion.cmake announce that the checkout is not a valid repository.
.git/
**/.git
.wrangler/

# Build directories & binaries
build/
# zpkg builds as a standalone project in its own directory (utils/zpkg). It is
# git-ignored like build/ and must be docker-ignored for the same reason: a
# CMakeCache.txt from the host names a source path that does not exist in the
# image, and stage 2b then refuses to configure instead of building.
build-zpkg*/
dist/
target/
bin/
import/
obj/
out/
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp

# C++ build artifacts & caches
.vs/
ipch/
*.pch
*.tlog
*.o
*.obj
.cache/
.zahlen-dev/
.pytest_cache/
__pycache__/
gcm.cache/

# CI-only, mounted into the build container and never baked into an image:
#   .jammy/   the Ubuntu 22.04 target sysroot (~1 GB of apt output)
#   .ccache/  the compiler cache shared across runs (can be several GB)
.jammy/
.ccache/

# Environments & heavy local assets
.venv/
env/
node_modules/
blender/
NSightAftermath/
resources/intermediate/

# IDE configs (keep .clang-format and .clang-tidy out of here so CI can use them)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS junk & temporary files
**/.DS_Store
Thumbs.db
*.tmp
*.bak
