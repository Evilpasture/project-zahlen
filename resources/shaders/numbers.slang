module numbers;

namespace Numbers {
    public static const float Pi = 3.141592653589793f;
    public static const float TwoPi = 2.0f * Pi;
    public static const float HalfPi = 0.5f * Pi;
    public static const float InvPi = 1.0f / Pi;
    public static const float InvTwoPi = 0.5f / Pi;
}
