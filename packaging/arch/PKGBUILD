# Maintainer: Evilpasture <housemaster@evilpasture.org>

pkgname=zpkg
_commit=e3de01b9f4c3b5cef6b00ca7ae5bf812936b987c

pkgver=2026.11.28
pkgrel=1
pkgdesc='Per-user package manager for Zahlen engine packages'
arch=('x86_64' 'aarch64')
url="https://github.com/Evilpasture/project-zahlen"
license=('GPL-3.0-or-later')

depends=('gcc-libs' 'zlib' 'zstd' 'openssl' 'curl' 'simdjson')
makedepends=('cmake' 'ninja' 'gcc')

source=("${pkgname}-${_commit}.tar.gz::https://github.com/Evilpasture/project-zahlen/archive/${_commit}.tar.gz")
sha256sums=('ace030237f09b32e63cf139de274aaec4ece346fac23e203d9ff41c361f99d97')

build() {
    cmake -S "project-zahlen-${_commit}/utils/zpkg" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DZPKG_BUILD_TESTS=ON
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    install -Dm755 build/zpkg "${pkgdir}/usr/bin/zpkg"
    install -Dm644 "project-zahlen-${_commit}/packaging/keys/zahlen-release.pub" \
        "${pkgdir}/usr/share/zahlen/zahlen-release-key.pub"
    install -Dm644 "project-zahlen-${_commit}/LICENSE.md" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
}
