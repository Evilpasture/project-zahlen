# The Zahlen toolchain manager, and nothing else.
#
# pacman owns exactly one Zahlen file: /usr/bin/zpkg. Engine packages are the
# developer's own: they are installed per user with zpkg into
# ${XDG_DATA_HOME:-~/.local/share}/zahlen, so they can be added, pinned and
# switched without root and without a system upgrade touching a running project.
#
# zpkg is built from source here rather than shipped as a script. It is a
# standalone CMake project (utils/zpkg) with no engine dependency, so it builds
# with the distribution's compiler and does not need the reflection-capable
# toolchain the engine itself requires.
pkgname=zahlen-zpkg
pkgver=0.1.0
pkgrel=1
pkgdesc='Per-user package manager for Zahlen engine packages'
# zpkg is ISA-baseline: no -mavx2, no -mfma, no CPU dispatch. The engine packages
# it installs are the ones with the narrow CPU contract, not the manager.
arch=('x86_64' 'aarch64')
url='https://github.com/Evilpasture/project-zahlen'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'zlib' 'zstd' 'openssl' 'curl')
makedepends=('cmake' 'ninja' 'gcc' 'simdjson')
options=('!strip')
_src="https://github.com/Evilpasture/project-zahlen/archive/v${pkgver}.tar.gz"
source=("zahlen-${pkgver}.tar.gz::${_src}")
sha256sums=('SKIP') # Run updpkgsums before distributing this recipe.

build() {
    cmake -S "${srcdir}/project-zahlen-${pkgver}/utils/zpkg" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DZPKG_BUILD_TESTS=OFF
    cmake --build build
}

check() {
    # Reconfigure with the tests on; they cover archive validation, signatures
    # and the store, which is the part a user cannot debug from the outside.
    cmake -S "${srcdir}/project-zahlen-${pkgver}/utils/zpkg" -B build-test -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DZPKG_BUILD_TESTS=ON
    cmake --build build-test
    (cd build-test && ctest --output-on-failure)
}

package() {
    install -Dm755 build/zpkg "${pkgdir}/usr/bin/zpkg"
}
