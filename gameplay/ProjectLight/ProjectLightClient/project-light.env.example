# Copy this file to the project root as .env, or point
# PROJECT_LIGHT_ENV_FILE at a private copy. Replace placeholders locally;
# do not commit real server tokens or account credentials.
PROJECT_LIGHT_SCHEME=replace-with-your-scheme
PROJECT_LIGHT_SERVER=127.0.0.1
PROJECT_LIGHT_PORT=5555
PROJECT_LIGHT_USER_ID=1
PROJECT_LIGHT_USERNAME=Player
PROJECT_LIGHT_TOKEN=replace-with-your-local-token
# Optional:
# PROJECT_LIGHT_PLACE=
